# ============================================================
# AI Voice Calling Agent — Environment Variables
# Copy this file to .env and fill in your actual values.
# ============================================================

# ── LLM: Groq ───────────────────────────────────────────────
# Get your free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Telephony: VoBiz ─────────────────────────────────────────
# Find these in your VoBiz Console → Settings → API Credentials
VOBIZ_AUTH_ID=your_vobiz_auth_id
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token

# The DID phone number you purchased from VoBiz (in E.164 format)
VOBIZ_FROM_NUMBER=+911171366938

# ── Dograh Secret Key ─────────────────────────────────────────
# Generate a strong random secret (e.g.: python -c "import secrets; print(secrets.token_hex(32))")
DOGRAH_SECRET_KEY=change-this-to-a-long-random-secret-32chars

# ── Public URL ────────────────────────────────────────────────
# The publicly reachable URL of your Dograh API.
# If running locally, use ngrok or your LAN IP.
# For ngrok: ngrok http 8080  → then set this to https://xxxx.ngrok-free.app
PUBLIC_URL=http://localhost:8080
